# API path: set both variables to enable direct Claude API generation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Local alternative: existing authenticated Claude CLI, with tools disabled.
WATCHREAD_CLAUDE_CLI=0
WATCHREAD_CLAUDE_MODEL=fable
# Optional hosted path; disabled on the public demo. Requires verified gateway access.
WATCHREAD_GATEWAY=0
# On Vercel, a private code of at least 16 bytes is required before model calls.
WATCHREAD_DEMO_CODE=
