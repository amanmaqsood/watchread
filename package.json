{
  "name": "watchread",
  "version": "1.0.0",
  "description": "A source-linked lecture companion with misconception-specific recovery practice.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run copy:check && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sample:build": "tsx scripts/build-sample.ts",
    "eval": "tsx scripts/evaluate.ts",
    "audit:ui": "tsx scripts/audit-ui.ts",
    "export:examples": "tsx scripts/export-examples.ts",
    "eval:adversarial": "tsx scripts/evaluate-adversarial.ts",
    "copy:check": "tsx scripts/check-copy.ts"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@vercel/oidc": "^3.8.8",
    "idb": "^8.0.3",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "private": true
}
